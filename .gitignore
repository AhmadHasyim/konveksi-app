```gitignore
# ================================
# Dependencies
# ================================
node_modules/
.pnp/
.pnp.js

# ================================
# Next.js
# ================================
.next/
out/
build/
Temp/

# ================================
# Testing
# ================================
coverage/

# ================================
# Environment / Secrets
# ================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example

# Jangan ignore .env.example
# .env.example sebaiknya di-commit ke Git

# ================================
# Prisma
# ================================
# Prisma migrations HARUS di-commit
# prisma/migrations/

# Jika menggunakan Prisma generated client
# biasanya berada di node_modules/.prisma
# sehingga otomatis sudah ter-ignore

# ================================
# TypeScript
# ================================
*.tsbuildinfo
next-env.d.ts

# ================================
# Logs
# ================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================================
# OS
# ================================
.DS_Store
Thumbs.db

# ================================
# Certificates / Private Keys
# ================================
*.pem
*.key
*.crt

# ================================
# Vercel
# ================================
.vercel/

# ================================
# IDE
# ================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.swp
*.swo

# ================================
# AI Coding Agents
# ================================
.agent/
.claude/
.AGENTS.md
.CLAUDE.md

# ================================
# Temporary files
# ================================
*.tmp
*.temp
*.bak

# ================================
# Local database / dumps
# ================================
*.dump
*.sqlite
*.sqlite3

# ================================
# OS / Editor
# ================================
.DS_Store


# AI Agent local configuration
.agents/
.claude/

AGENTS.md
CLAUDE.md


```
